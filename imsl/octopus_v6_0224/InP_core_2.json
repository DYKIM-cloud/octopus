{
    "metadata" : 
    {
        "subject":"InP_core_test",
        "group":"Hanyang",
        "logLevel":"DEBUG"
    },
    "algorithm":{
        "model":"BayesianOptimization",
        "batchSize":1, 
        "totalCycleNum":1,
        "verbose":0,
        "initRandom":20,       
        "randomState":0,
        "sampling":{
            "samplingMethod":"latin",
            "samplingNum":20
        },
        "acq":{
            "acqMethod":"ucb",
            "acqSampler":"greedy",
            "acqHyperparameter":{
                "kappa":10.0
            }
        },
        "loss":{
            "lossMethod":"lambdamaxpvLoss",
            "lossTarget":{
                "GetAbs":{
                    "Property":{
                        "lambdamax":470,
                        "p_v_ratio":1.6
                    },
                    "Ratio":{
                        "lambdamax":0.1,
                        "p_v_ratio":0.9
                    }
                }
            }
        }, 
        "prange":{
            "AddSolution=In_Injectionrate" : [100,400,10],
            "AddSolution=P_Injectionrate" : [100,400,10],
            "preHeat=Temperature" : [40,60,1],
            "Heat=Temperature":[225,250,1]
        },
        "initParameterList":[],
        "constraints":[
            "x[0] - 1.2*x[1] - 0.0666667", "2.2*x[1] - x[0] + 0.4"
        ]
    },
    "process":{
        "Synthesis":{
            "FlowSynthesis":{
                "Sequence":["FlowSynthesis_preHeat","FlowSynthesis_Heat","FlowSynthesis_AddSolution=In","FlowSynthesis_AddSolution=P"],
                "fixedParams":{}
            }
        }
        ,
        "Characterization":{
            "UV":{
                "Sequence":["UV_GetAbs"],
                "fixedParams":
                {
                    "Hyperparameter":{
                        "WavelengthMin":{
                            "Description":"WavelengthMin=300 (int): slice wavlength section depending on wavelength_min and wavelength_max",
                            "Value": 400,
                            "Dimension": "nm"
                        },
                        "WavelengthMax":{
                            "Description":"WavelengthMax=849 (int): slice wavlength section depending on wavelength_min and wavelength_max",
                            "Value": 700,
                            "Dimension": "nm"
                        },
                        "BoxCarSize":{
                            "Description":"BoxCarSize=10 (int): smooth strength",
                            "Value": 10,
                            "Dimension": "None"
                        },
                        "Prominence":{
                            "Description":"Prominence=0.01 (float): minimum peak Intensity for detection",
                            "Value": 0.001,
                            "Dimension": "None"
                        },
                        "PeakWidth":{
                            "Description":"PeakWidth=20 (int): minumum peak width for detection",
                            "Value": 1,
                            "Dimension": "nm"
                        }
                    }
                }
            },
            "PL":
            {
                "Sequence":["PL_GetPl"],
                "fixedParams": {
                    "Hyperparameter":{
                        "WavelengthMin":{
                            "Description":"WavelengthMin=300 (int): slice wavlength section depending on wavelength_min and wavelength_max",
                            "Value": 440,
                            "Dimension": "nm"
                        },
                        "WavelengthMax":{
                            "Description":"WavelengthMax=849 (int): slice wavlength section depending on wavelength_min and wavelength_max",
                            "Value": 849,
                            "Dimension": "nm"
                        },
                        "BoxCarSize":{
                            "Description":"BoxCarSize=10 (int): smooth strength",
                            "Value": 5,
                            "Dimension": "None"
                        },
                        "Prominence":{
                            "Description":"Prominence=0.01 (float): minimum peak Intensity for detection",
                            "Value": 0.01,
                            "Dimension": "None"
                        },
                        "PeakWidth":{
                            "Description":"PeakWidth=20 (int): minumum peak width for detection",
                            "Value": 5,
                            "Dimension": "nm"
                        }
                    }
                }
            }
        },
        "Collection":{
            "Collector":{
                "Sequence":["Collector_Collect"],
                "fixedParams":{"Collect=Volume": 1000}
            }
        }
    }
}
